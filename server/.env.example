PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Real provider remains disabled until explicitly enabled here.
ALLOW_REAL_API=false
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODELS=gpt-4.1-mini
REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_PER_MINUTE=60
# Optional BFF access token. UI sends it from memory only (never localStorage).
BFF_ACCESS_TOKEN=
# Optional alternate persistence file (tests use a temporary directory).
# DATA_FILE=server/data/workbench.json
